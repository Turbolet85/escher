+/// Whether `node` is a scroll container. A node with no computed styles yet (an element hit or
+/// placed before its first restyle) reads as none, never a panic.
+fn is_scroll_container(node: &Node) -> bool {
+    if node
+        .try_stylo_element_data()
+        .and_then(|stylo| stylo.computed_styles())
+        .is_none()
+    {
+        return false;
+    }
+    let overflow = node.layout_style().overflow();
+    overflow.x.is_scroll_container() || overflow.y.is_scroll_container()
+}
