+        let size = Size {
+            width: 100.0,
+            height: 80.0,
+        };
+        let overflow = mirror_overflow(
+            taffy::ScrollableOverflow::ZERO,
+            size,
+            Point { x: true, y: true },
+            true,
+        );
+        let layout = Layout {
+            size,
+            scrollable_overflow_rect: overflow,
+            ..Layout::new()
+        };
+        assert_eq!((layout.scroll_width(), layout.scroll_height()), (0.0, 0.0));
+    }
+}
